type token =
    UNDERSCORE
  | TYVAR of string
  | TYPE
  | TRUE
  | THEN
  | SEMICOLON
  | RPAR
  | REF
  | RCURLY
  | RAISE
  | PRINT
  | PIPE
  | ORELSE
  | OF
  | NUM of int
  | LPAR
  | LET
  | LCURLY
  | IN
  | IF
  | IDENT of string
  | GOSPEL_COMMENT of string
  | FUN
  | FALSE
  | EXCEPTION
  | EOF
  | END
  | ELSE
  | DEREF
  | DATATYPE
  | COMMA
  | CASE
  | BSUB
  | BNEQ
  | BMUL
  | BMOD
  | BMINUS
  | BLT
  | BLE
  | BGT
  | BGE
  | BEQ
  | BDIV
  | BADD
  | ASSIGN_REF
  | ASSIGN
  | ARROW
  | ANDALSO
val mk_id : string -> Lexing.position -> Lexing.position -> Ast.ident
val menhir_begin_marker : int
val xv_tyvar_list : string list
val xv_typ : Ast.typ
val xv_toplevel : Ast.toplevel
val xv_pattern_seq : Ast.pattern list
val xv_pattern : Ast.pattern
val xv_op : Ast.op
val xv_nonempty_list_apattern_ : Ast.pattern list
val xv_nonempty_list_aexpr_ : Ast.expr list
val xv_more_patterns : Ast.pattern list
val xv_more_constructors : Ast.constructor list
val xv_more_case_clauses : Ast.case_clause list
val xv_list_toplevel_ : Ast.file
val xv_list_ident_ : Ast.ident list
val xv_list_expr_ : Ast.expr list
val xv_list_atyp_ : Ast.typ list
val xv_ident : Ast.ident
val xv_file : Ast.file
val xv_expr_seq_tail : Ast.expr list
val xv_expr_seq : Ast.expr list
val xv_expr : Ast.expr
val xv_def : Ast.def
val xv_constructor_list : Ast.constructor list
val xv_constructor : Ast.constructor
val xv_case_clauses : Ast.case_clause list
val xv_case_clause : Ast.case_clause
val xv_atyp : Ast.typ
val xv_apattern : Ast.pattern
val xv_aexpr : Ast.expr
val menhir_end_marker : int
