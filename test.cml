(*@ let rec lemma heap_mem (h: raw_heap)
    requires { heap h }
    variant { h }
    ensures { forall x. le_root x h -> forall y. mem y h -> x <= y }
  = match h with
    | E -> ()
    | H t -> heap_mem_tree t
    end
  with lemma heap_mem_tree (t: tree)
