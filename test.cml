fun is_empty hh =
  (case hh of
    E => true
  | _ => false)
(*@ b = is_empty hh
    ensures b <-> size_heap hh = 0 *)

exception Empty

fun find_min hh =
  (case hh of
    E => raise Empty
  | H (T x _) => x)
(*@ r = find_min hh
    requires 0 < size_heap hh
    ensures r = minimum hh *)

fun merge h1 h2 =
  (case (h1, h2) of
    (E, h) => h
  | (h, E) => h
  | (H (T x1 l1), H (T x2 l2)) =>
      if x1 <= x2 then H (T x1 ((T x2 l2) :: l1))
      else H (T x2 ((T x1 l1) :: l2)))
(*@ result = merge h1 h2
    ensures size_heap result = size_heap h1 + size_heap h2
    ensures forall x. occ_heap x result = occ_heap x h1 + occ_heap x h2 *)

fun insert x hh = merge (H (T x [])) hh
(*@ result = insert x hh
    ensures size_heap result = size_heap hh + 1
    ensures occ_heap x result = occ_heap x hh + 1
    ensures forall y. x <> y -> occ_heap y result = occ_heap y hh *)

fun merge_pairs l =
  (case l of
    [] => E
  | t :: [] => H t
  | t1 :: t2 :: r =>
      let val h1 = H t1 in
      let val h2 = H t2 in
      merge (merge h1 h2) (merge_pairs r)
      end
      end)
(*@ result = merge_pairs l
    requires heap_list l
    variant List.length l
    ensures size_heap result = size_list l
    ensures forall x. occ_heap x result = occ_list x l *)

fun delete_min hh =
  (case hh of
    E => raise Empty
  | H (T _ l) => merge_pairs l)
(*@ result = delete_min hh
    requires 0 < size_heap hh
    ensures occ_heap (minimum hh) result = occ_heap (minimum hh) hh - 1
    ensures forall y. y <> minimum hh -> occ_heap y result = occ_heap y hh
    ensures size_heap result = size_heap hh - 1 *)